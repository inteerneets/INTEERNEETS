{
  // Cloudflare Workers (static assets + API). Worker name must match the one in the dashboard.
  "name": "inteerneets",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
